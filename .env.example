# Database
# Use a strong password — do not commit real credentials
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5437/postgres

# Qdrant
QDRANT_URL=http://localhost:6334

# Ollama
OLLAMA_URL=http://localhost:11434

# Governance Audit Bus
AUDIT_BUS_DB_PATH=./data/audit.db
# Generate with: openssl rand -hex 32
AUDIT_BUS_SERVICE_KEY=

# JWT Authentication
# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=agentic-data-plane

# Quality
QUALITY_BLOCKING_THRESHOLD=700
QUALITY_ALERT_DECLINE_PERCENT=5

# Classification
CLASSIFICATION_MIN_CONFIDENCE=0.75
CLASSIFICATION_PII_DETECTION_TARGET=0.985

# Lineage
LINEAGE_RETENTION_YEARS_STANDARD=7
LINEAGE_RETENTION_YEARS_RESTRICTED=10
LINEAGE_TRACE_MAX_DEPTH=50
LINEAGE_TRACE_SLA_MS=500

# Pipeline Observability
PIPELINE_ANOMALY_SIGMA_THRESHOLD=2.0
PIPELINE_NULL_RATE_SPIKE_THRESHOLD=0.10
PIPELINE_ALERT_DELIVERY_SLA_MS=30000

# API Server
API_PORT=8099
DASHBOARD_PORT=8100

# GraphQL Limits
GRAPHQL_DEPTH_LIMIT=10
GRAPHQL_COMPLEXITY_LIMIT=1000
