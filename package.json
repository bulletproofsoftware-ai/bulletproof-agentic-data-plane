{
  "name": "agentic-data-plane",
  "version": "1.0.0",
  "description": "Agentic Data Plane \u2014 Governance Observability Layer for conductor-data-pipeline",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --forceExit",
    "test:unit": "node --experimental-vm-modules node_modules/.bin/jest tests/unit --forceExit",
    "lint": "eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "dashboard:dev": "cd src/dashboard && npx vite --port 8100",
    "dashboard:build": "cd src/dashboard && npx vite build"
  },
  "overrides": {
    "ws": "^8.21.1",
    "form-data": "^4.0.6",
    "uuid": "^14.0.1",
    "test-exclude": "^8.0.0",
    "glob": "^11.1.0",
    "brace-expansion": "^5.0.8",
    "esbuild": "^0.28.1",
    "@apollo/protobufjs": "1.2.8",
    "@protobufjs/codegen": "2.0.5"
  },
  "dependencies": {
    "@apollo/server": "^5.5.1",
    "@as-integrations/express4": "^1.1.2",
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "graphql": "^16.9.0",
    "graphql-depth-limit": "^1.1.0",
    "graphql-subscriptions": "^3.0.0",
    "graphql-ws": "^5.16.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.15.0",
    "pg": "^8.13.0",
    "uuid": "^14.0.1",
    "ws": "^8.21.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cors": "^2.8.17",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.0",
    "@types/graphql-depth-limit": "^1.1.6",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.0",
    "@types/pdfkit": "^0.13.7",
    "@types/pg": "^8.11.10",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "eslint": "^10.8.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.65.0"
  }
}
